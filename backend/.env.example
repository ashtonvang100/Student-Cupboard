# Local PostgreSQL only. The application never creates the database.
PGHOST=localhost
PGPORT=5432
PGDATABASE=student_cupboard
PGUSER=
PGPASSWORD=
HOST=127.0.0.1
PORT=3000
# Optional, for integration tests ONLY (database name must be student_cupboard_test).
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/student_cupboard_test

# Optional URL takes precedence over PG* settings. Leave blank for local PG* settings.
DATABASE_URL=
# Remote/RDS access requires explicit opt-in AND its trusted CA PEM certificate.
DATABASE_ALLOW_REMOTE=false
DATABASE_CA_CERT=
# Server-side only; never send this key to a browser.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5-mini
# Per-person credentials. Generate long random tokens; empty array denies all API resource access.
# Example shape: [{"id":"staff-id","role":"staff","token":"a-random-token-at-least-32-characters"}]
STAFF_API_TOKENS=[]
